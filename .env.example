# Copy to .env for local development. Never commit .env.
# On Vercel, set these in Project Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Required (API / serverless)
# ---------------------------------------------------------------------------

# Supabase Postgres connection string.
# Prefer the "Transaction" pooler URI (port 6543) for Vercel Serverless:
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Direct connection (port 5432) is fine for local long-lived Node / Replit.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# HMAC key for admin Bearer tokens (use a long random string in production)
SESSION_SECRET=change-me

# Admin login password
ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Local API listen port only (not used by Vercel serverless)
PORT=8080

NODE_ENV=development
LOG_LEVEL=info

# Vite base path (frontend build)
BASE_PATH=/

# URL do dashboard Web Analytics na Vercel (aba Admin → Acessos).
# Ajuste se o slug do time/projeto for diferente.
# VITE_VERCEL_ANALYTICS_URL=https://vercel.com/fernandocsa/csa-hub/analytics
